#!/bin/sh
# Install as <ndk-r14b>/ndk-build on modern macOS; target files are unchanged.
set -eu
DIR="$(cd "$(dirname "$0")" && pwd)"
export NDK_HOST_AWK=/usr/bin/awk
if [ "$(uname -m)" = arm64 ]; then
    exec /usr/bin/arch -x86_64 /bin/bash "$DIR/build/ndk-build" "$@"
fi
exec "$DIR/build/ndk-build" "$@"
